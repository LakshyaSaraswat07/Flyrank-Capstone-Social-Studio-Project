{
  "name": "flyrank-capstone-social-studio",
  "version": "1.0.0",
  "description": "Social Media Studio - Scheduled Multi-Platform Publishing System with Idempotency, Constraint Profiles, and Adapter Architecture",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "seed": "tsx src/database/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:probes": "tsx scripts/run-probes.ts",
    "simulate:crash": "tsx scripts/simulate-worker-crash.ts"
  },
  "keywords": [
    "social-media",
    "scheduling",
    "idempotency",
    "adapter-pattern",
    "content-workflow"
  ],
  "author": "FlyRank Intern",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}