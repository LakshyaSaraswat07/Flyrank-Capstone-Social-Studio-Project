# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (SQLite file path)
DATABASE_PATH=./data/social_studio.db

# Active Default Publisher Adapter (mock_x | mock_linkedin | telegram | discord)
DEFAULT_PUBLISHER_ADAPTER=mock_x

# Real Adapter: Telegram Bot (Optional for live Telegram channel delivery)
# 1. Create a bot with @BotFather to get your token
# 2. Add bot as Administrator to your Telegram channel
# 3. Get your channel/chat ID (e.g. -100xxxxxxxxxx or @channelname)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Real Adapter: Discord Webhook (Optional for live Discord delivery)
# In Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# AI Generation Provider (Optional - built-in deterministic generator works $0 / no key)
AI_PROVIDER=template
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Scheduler Configuration
SCHEDULER_POLL_INTERVAL_MS=3000
SCHEDULER_LOCK_TIMEOUT_SECONDS=60
MAX_PUBLISH_RETRIES=3
